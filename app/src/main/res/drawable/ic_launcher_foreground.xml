<?xml version="1.0" encoding="utf-8"?>
<!--
  Isometric wireframe cube, the standard CAD/CAM motif.

  Geometry: centre (54,54), circumradius r=33, so the silhouette spans
  x 25.4..82.6 and y 21..87. That keeps the whole mark inside the 66dp
  adaptive-icon safe zone (the centre 66x66 of the 108x108 viewport), so no
  launcher mask or circle crop can clip a corner off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- silhouette -->
    <path
        android:pathData="M54,21 L82.58,37.5 L82.58,70.5 L54,87 L25.42,70.5 L25.42,37.5 Z"
        android:strokeColor="#B9F0FF"
        android:strokeWidth="3.4"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- the three edges meeting at the near vertex -->
    <path
        android:pathData="M54,54 L54,21"
        android:strokeColor="#B9F0FF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,54 L25.42,70.5"
        android:strokeColor="#B9F0FF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,54 L82.58,70.5"
        android:strokeColor="#B9F0FF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />
</vector>